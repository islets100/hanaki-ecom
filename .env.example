# Create this value in the Alibaba Cloud Model Studio console. Never commit a real key.
AI_DASHSCOPE_API_KEY=your-dashscope-key

# Optional model settings; the values below are the recommended defaults.
AI_CHAT_MODEL=qwen-plus
AI_JUDGE_MODEL=qwen-max
AI_EMBEDDING_MODEL=text-embedding-v3
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=1200
AI_EMBEDDING_DIMENSIONS=512
AGENT_REDIS_ENABLED=false
AGENT_REDIS_HOST=localhost
AGENT_REDIS_PORT=6379
AGENT_REDIS_PASSWORD=
AGENT_REDIS_DATABASE=0
AGENT_RERANK_ENABLED=false
AGENT_RERANK_MODEL=qwen3-rerank
AGENT_ELASTICSEARCH_ENABLED=false
AGENT_MEMORY_ELASTICSEARCH_ENABLED=false
AGENT_MEMORY_ELASTICSEARCH_INDEX=hanaki-memory-v2
AGENT_ELASTICSEARCH_URL=http://localhost:9200
# RAG 查询只走稳定 read alias；升级 mapping/embedding 时创建新 physical index 后原子切换别名。
AGENT_ELASTICSEARCH_INDEX_VERSION=knowledge-v1
AGENT_ELASTICSEARCH_PHYSICAL_INDEX=hanaki-knowledge-v1
AGENT_ELASTICSEARCH_READ_ALIAS=hanaki-knowledge-read
AGENT_ELASTICSEARCH_WRITE_ALIAS=hanaki-knowledge-write
AGENT_ELASTICSEARCH_API_KEY=
AGENT_ELASTICSEARCH_USERNAME=
AGENT_ELASTICSEARCH_PASSWORD=
AGENT_RAG_CONFIG_VERSION=rag-v1
AGENT_RAG_POLICY_VERSION=policy-v1
AGENT_RAG_LEXICAL_TOP_K=40
AGENT_RAG_VECTOR_TOP_K=40
AGENT_RAG_VECTOR_NUM_CANDIDATES=160
AGENT_RAG_FUSION_TOP_K=30
AGENT_RERANK_INPUT_TOP_N=30
AGENT_RERANK_OUTPUT_TOP_K=6
AGENT_REQUEST_LEASE_SECONDS=300
AGENT_REQUEST_DUPLICATE_WAIT_SECONDS=35
AGENT_KNOWLEDGE_OUTBOX_LEASE_SECONDS=60
AGENT_MAX_PROMPT_TOKENS=6000
AI_RETRY_MAX_ATTEMPTS=2

# Replace this with a random value of at least 32 bytes in production.
CONFIRM_SECRET=replace-with-a-long-random-secret

# 客服工作台注册邀请码。生产环境必须替换为足够长的随机值。
STORE_AGENT_INVITE_CODE=replace-with-store-agent-invite-code
OFFICIAL_AGENT_INVITE_CODE=replace-with-official-agent-invite-code
AUTH_SESSION_HOURS=24
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
SAAS_PLATFORM_NAME=花木商城平台
# 平台开通新商家租户时使用，生产环境请设置为高强度随机值。
SAAS_TENANT_PROVISIONING_KEY=replace-with-a-long-random-provisioning-key

# OpenTelemetry Collector（启动 observability 套件后开启）
OTEL_EXPORT_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# qwen-plus 中国内地 0-128K 区间列表价；切换模型时请同步修改。
AI_INPUT_COST_PER_MILLION_CNY=0.8
AI_OUTPUT_COST_PER_MILLION_CNY=2.0
# Local database and observability credentials. Replace every placeholder before use.
POSTGRES_PASSWORD=replace-with-local-postgres-password
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
LANGFUSE_POSTGRES_PASSWORD=replace-with-langfuse-postgres-password
LANGFUSE_SALT=replace-with-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-character-key
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
LANGFUSE_REDIS_PASSWORD=replace-with-redis-password
MINIO_ROOT_PASSWORD=replace-with-minio-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-nextauth-secret
LANGFUSE_INIT_PROJECT_SECRET_KEY=replace-with-langfuse-project-secret
LANGFUSE_INIT_USER_PASSWORD=replace-with-langfuse-admin-password
